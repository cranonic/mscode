{
  "id":          "{{EXT_ID}}",
  "name":        "{{EXT_NAME}}",
  "version":     "{{VERSION}}",
  "description": "{{EXT_DESC}}",
  "category":    "Other",
  "tags":        ["sidebar"],
  "icon":        "assets/logo.png",
  "iconLetter":  "{{ICON_LETTER}}",
  "source":      "src/main.{{LANG_EXT}}",
  "main":        "dist/main.js",
  "activates":   ["onCommand:{{CMD_PREFIX}}.focusSidebar"],
  "readme":      "README.md",
  "changelog":   "CHANGELOG.md",
  "license":     "LICENSE.txt",
  "contributes": {
    "activityBar": [
      {
        "id":       "{{CMD_PREFIX}}-sidebar-panel",
        "title":    "{{EXT_NAME}} Workspace",
        "icon":     "sparkle",
        "position": "top",
        "priority": 90
      }
    ],
    "commands": [
      {
        "id":    "{{CMD_PREFIX}}.focusSidebar",
        "title": "{{EXT_NAME}}: Focus View Panel",
        "icon":  "layout-sidebar-left"
      }
    ],
    "configuration": "./config/settings.json"
  }
}
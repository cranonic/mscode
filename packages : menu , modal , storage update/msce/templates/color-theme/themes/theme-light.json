{
  "name": "{{EXT_NAME}} Light",
  "type": "light",
  "uiColors": {
    "ms-bg-main": "#ffffff",
    "ms-bg-side": "#f5f5f5",
    "ms-bg-activity": "#eaeaea",
    "ms-activity-hover": "#d6d6d6",
    "ms-tab-inactive-bg": "#f5f5f5",
    "ms-tab-active-bg": "#ffffff",
    "ms-text-main": "#4d4d4c",
    "ms-text-faded": "#8e908c",
    "ms-text-bright": "#1d1f21",
    "ms-border-light": "#e0e0e0",
    "ms-border-dark": "#cccccc",
    "ms-menu-border": "#e0e0e0",
    "ms-separator": "#e0e0e0",
    "ms-accent": "#4271ae",
    "ms-icon-hover-bg": "#e0e0e0",
    "ms-menu-hover-bg": "#d6d6d6",
    "ms-shadow": "rgba(0, 0, 0, 0.1)",
    "ms-settings-bg": "#ffffff",
    "ms-settings-category-color": "#8e908c",
    "ms-settings-title-color": "#4d4d4c",
    "ms-settings-desc-color": "#8e908c",
    "ms-settings-link-color": "#4271ae",
    "ms-input-bg": "#f5f5f5",
    "ms-input-fg": "#4d4d4c",
    "ms-input-border": "#cccccc",
    "ms-input-focus-border": "#4271ae",
    "ms-code-bg": "rgba(0, 0, 0, 0.05)",
    "ms-code-fg": "#718c00"
  },
  "editorColors": {
    "editor.background": "#ffffff",
    "editor.foreground": "#4d4d4c",
    "editor.selectionBackground": "#d6d6d6",
    "editor.inactiveSelectionBackground": "#efefef",
    "editor.lineHighlightBackground": "#efefef",
    "editorCursor.foreground": "#4d4d4c",
    "editorWhitespace.foreground": "#e0e0e0",
    "editorLineNumber.foreground": "#8e908c",
    "editorLineNumber.activeForeground": "#4d4d4c",
    "editorIndentGuide.background": "#efefef",
    "editorIndentGuide.activeBackground": "#cccccc",
    "editorSuggestWidget.background": "#f5f5f5",
    "editorSuggestWidget.border": "#cccccc",
    "editorSuggestWidget.selectedBackground": "#e0e0e0",
    "minimap.background": "#ffffff"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#8e908c", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#8959a8" } },
    { "scope": ["string"], "settings": { "foreground": "#718c00" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#f5871f" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#c82829" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#4271ae" } },
    { "scope": ["entity.name.class", "entity.name.type", "support.class"], "settings": { "foreground": "#eab700" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#3e999f" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#c82829" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#f5871f" } },
    { "scope": ["punctuation", "punctuation.separator"], "settings": { "foreground": "#4d4d4c" } }
  ]
}
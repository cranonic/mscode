{
  "name": "{{EXT_NAME}} Dark",
  "type": "dark",
  "uiColors": {
    "ms-bg-main": "#1d1f21",
    "ms-bg-side": "#282a2e",
    "ms-bg-activity": "#151718",
    "ms-activity-hover": "#373b41",
    "ms-tab-inactive-bg": "#282a2e",
    "ms-tab-active-bg": "#1d1f21",
    "ms-text-main": "#c5c8c6",
    "ms-text-faded": "#969896",
    "ms-text-bright": "#ffffff",
    "ms-border-light": "#282a2e",
    "ms-border-dark": "#151718",
    "ms-menu-border": "#373b41",
    "ms-separator": "#282a2e",
    "ms-accent": "#81a2be",
    "ms-icon-hover-bg": "#373b41",
    "ms-menu-hover-bg": "#373b41",
    "ms-shadow": "rgba(0, 0, 0, 0.5)",
    "ms-settings-bg": "#1d1f21",
    "ms-settings-category-color": "#969896",
    "ms-settings-title-color": "#c5c8c6",
    "ms-settings-desc-color": "#969896",
    "ms-settings-link-color": "#81a2be",
    "ms-input-bg": "#282a2e",
    "ms-input-fg": "#c5c8c6",
    "ms-input-border": "#373b41",
    "ms-input-focus-border": "#81a2be",
    "ms-code-bg": "rgba(255, 255, 255, 0.05)",
    "ms-code-fg": "#b5bd68"
  },
  "editorColors": {
    "editor.background": "#1d1f21",
    "editor.foreground": "#c5c8c6",
    "editor.selectionBackground": "#373b41",
    "editor.inactiveSelectionBackground": "#282a2e",
    "editor.lineHighlightBackground": "#282a2e",
    "editorCursor.foreground": "#c5c8c6",
    "editorWhitespace.foreground": "#373b41",
    "editorLineNumber.foreground": "#969896",
    "editorLineNumber.activeForeground": "#c5c8c6",
    "editorIndentGuide.background": "#282a2e",
    "editorIndentGuide.activeBackground": "#373b41",
    "editorSuggestWidget.background": "#282a2e",
    "editorSuggestWidget.border": "#373b41",
    "editorSuggestWidget.selectedBackground": "#373b41",
    "minimap.background": "#1d1f21"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#969896", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#b294bb" } },
    { "scope": ["string"], "settings": { "foreground": "#b5bd68" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#de935f" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#cc6666" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#81a2be" } },
    { "scope": ["entity.name.class", "entity.name.type", "support.class"], "settings": { "foreground": "#f0c674" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#8abeb7" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#cc6666" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#de935f" } },
    { "scope": ["punctuation", "punctuation.separator"], "settings": { "foreground": "#c5c8c6" } }
  ]
}
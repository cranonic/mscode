.ms-settings-item:hover {
  border: #03A9F4 1px solid;
  background: transparent;
}

#setting-coderunner pre code {
  background-color: var(--ms-code-bg);
  color: var(--ms-code-fg);
  padding: 2px 5px;
  border-radius: 4px;
  font-family: monospace;
  font-size: 12.5px;
  width: 100%;
  overflow-wrap: break-word;
  white-space: pre-wrap;
}